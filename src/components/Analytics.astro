---
// Google Analytics 4 con Consent Mode: no se envían datos hasta que el visitante acepta las cookies
const ID = 'G-F5ESR9CZMZ';
---
<script is:inline define:vars={{ ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  let guardado = null;
  try { guardado = localStorage.getItem('cookies'); } catch (e) {}
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: guardado === 'si' ? 'granted' : 'denied',
  });
  gtag('js', new Date());
  gtag('config', ID);
  const s = document.createElement('script');
  s.async = true;
  s.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
  document.head.appendChild(s);
</script>

<div class="cookies band-dark" id="cookies" hidden>
  <p>Usamos cookies de analítica para saber cómo se usa la web. ¿Las aceptas?</p>
  <div>
    <button class="btn solid" data-cookies="si">Aceptar</button>
    <button class="btn" data-cookies="no">Rechazar</button>
  </div>
</div>

<script is:inline>
  (() => {
    const aviso = document.getElementById('cookies');
    let guardado = null;
    try { guardado = localStorage.getItem('cookies'); } catch (e) {}
    if (!guardado) aviso.hidden = false;
    aviso.addEventListener('click', (e) => {
      const valor = e.target.closest('[data-cookies]')?.dataset.cookies;
      if (!valor) return;
      try { localStorage.setItem('cookies', valor); } catch (e) {}
      if (valor === 'si') gtag('consent', 'update', { analytics_storage: 'granted' });
      aviso.hidden = true;
    });
  })();
</script>
