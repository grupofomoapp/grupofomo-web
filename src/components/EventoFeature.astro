---
import type { Evento } from '../data/eventos';

interface Props {
  evento: Evento;
  izquierda?: boolean;
  etiqueta?: string;
}

const { evento, izquierda = false, etiqueta } = Astro.props;
---
<div class:list={["feature", { izquierda }]} id={evento.id}>
  <div class="photo logo-panel band-dark"><img src={evento.logo} alt={evento.nombre} loading="lazy"></div>
  <div class="text">
    {etiqueta && <span class="label">{etiqueta}</span>}
    {evento.meta && <div class="meta">{evento.meta.map((m) => <span>{m}</span>)}</div>}
    <h3>{evento.nombre}</h3>
    <p>{evento.texto}</p>
    <div class="botones">
      {evento.web
        ? <a class="btn" href={evento.web}>Visitar web</a>
        : evento.info !== false && <a class="btn" href={`/${evento.slug}`}>Info + eventos</a>}
      {evento.redes?.map((r) => <a class="btn" href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}
    </div>
  </div>
</div>
