---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Analytics from '../components/Analytics.astro';
import { anyosExperiencia } from '../data/eventos';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Grupo FOMO',
  description = `GRUPO FOMO: Mirablau Club, La Rumba Barcelona, Una Noche Tonta y Una Tarde Tonta. Más de ${anyosExperiencia} años en la organización de eventos en Barcelona.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const imagen = new URL('/img/og.png', Astro.site);
// Código de verificación de Google Search Console (método "Etiqueta HTML")
const googleVerificacion = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="sitemap" href="/sitemap.xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Grupo FOMO">
<meta property="og:locale" content="es_ES">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={imagen}>
<meta name="twitter:card" content="summary_large_image">
{googleVerificacion && <meta name="google-site-verification" content={googleVerificacion}>}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;125,600;125,800;125,900&display=swap">
</head>
<body>
<header class="topbar">

<nav class="band-light">
  <div class="wrap">
    <a class="mark" href="/" aria-label="GRUPO FOMO, inicio"><Logo /></a>
  </div>
</nav>
</header>

<main id="inicio">
<slot />
</main>

<footer>
  <div class="wrap">
    <span>© {new Date().getFullYear()}, GRUPO FOMO, S.L. · CIF B56733157 · C/ Nàpols, 338‑340, 08025 Barcelona · grupofomo@gmail.com</span>
    <ul>
      <li><a href="https://instagram.com/grupofomo">Instagram</a></li>
      <li><a href="/aviso-legal">Aviso legal</a></li>
      <li><a href="/privacidad">Privacidad</a></li>
      <li><a href="/cookies">Cookies</a></li>
      <li><a href="/#contacto">Contacto</a></li>
    </ul>
  </div>
</footer>
<Analytics />
</body>
</html>
