---
import Base from '../layouts/Base.astro';
import EventoFeature from '../components/EventoFeature.astro';
import Newsletter from '../components/Newsletter.astro';
import { club, fiestas, graduacions, marcas } from '../data/eventos';
---
<Base>
  <div class="band-dark">
    <header class="wrap hero">
      <h1><span>Fear of</span> <span>missing out</span></h1>
      <p>El <b>FOMO</b> es esa chispa que te hace querer estar en <b>el lugar correcto</b>, en <b>el momento justo</b>. Es el miedo a perderte los <b>mejores eventos</b>.</p>
    </header>
  </div>

  <section id="servicios">
    <div class="wrap">
      <div class="head">
        <span class="label">Nuestros servicios</span>
        <h2>Más de 15 años en la organización de eventos</h2>
        <p>Ponemos toda esa experiencia al servicio de salas, marcas y particulares.</p>
      </div>
      <div class="services">
        <article>
          <h3>Gestión de locales</h3>
          <p>Ayudamos a las salas a optimizar su gestión, hacer crecer sus redes sociales y aumentar su facturación.</p>
        </article>
        <article>
          <h3>Organización de fiestas</h3>
          <p>Creamos y gestionamos marcas de fiesta, cada una con su propia identidad.</p>
        </article>
        <article>
          <h3>Eventos privados</h3>
          <p>Conseguimos los mejores espacios de Barcelona para eventos privados de cualquier tipo.</p>
        </article>
      </div>
      <a class="btn" href="mailto:grupofomo@gmail.com">Solicitar más información</a>
    </div>
  </section>

  <div class="band-dark bar-title">
    <h2 class="wrap">Nuestros proyectos</h2>
  </div>

  <section>
    <div class="wrap">
      <div class="head">
        <span class="label">Graduaciones</span>
      </div>
      <EventoFeature evento={graduacions} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <span class="label">Gestión de local</span>
      </div>
      <EventoFeature evento={club} izquierda />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <span class="label">Nuestras fiestas</span>
      </div>
      {fiestas.map((f, i) => <EventoFeature evento={f} izquierda={i % 2 === 1} />)}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <span class="label">Más marcas</span>
      </div>
      <div class="marcas">
        {marcas.map((m) => (
          <div class="marca" id={m.id}>
            <div class="photo logo-panel"><img src={m.logo} alt={m.nombre} loading="lazy"></div>
            <h3>{m.nombre}</h3>
            {m.texto && <p>{m.texto}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
</Base>
