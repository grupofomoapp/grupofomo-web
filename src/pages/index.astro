---
import Base from '../layouts/Base.astro';
import EventoFeature from '../components/EventoFeature.astro';
import Contacto from '../components/Contacto.astro';
import { anyosExperiencia, club, fiestas, graduacions, marcas, padel } from '../data/eventos';
---
<Base>
  <div class="band-dark">
    <header class="wrap hero">
      <h1><span>Fear of</span> <span>missing out</span></h1>
      <p>El <b>FOMO</b> es esa chispa que te hace querer estar en <b>el lugar correcto</b>, en <b>el momento justo</b>. Es el miedo a perderte los <b>mejores eventos</b>.</p>
    </header>
  </div>

  <section id="servicios">
    <div class="wrap">
      <div class="head">
        <span class="label">Nuestros servicios</span>
        <h2>Más de {anyosExperiencia} años en la organización de eventos</h2>
        <p>Ponemos toda esa experiencia al servicio de salas, marcas y particulares.</p>
      </div>
      <div class="services">
        <article>
          <h3>Gestión de locales</h3>
          <p>Ayudamos a las salas a optimizar su gestión, hacer crecer sus redes sociales y aumentar su facturación.</p>
        </article>
        <article>
          <h3>Organización de fiestas</h3>
          <p>Creamos y gestionamos marcas de fiesta, cada una con su propia identidad.</p>
        </article>
        <article>
          <h3>Eventos privados</h3>
          <p>Conseguimos los mejores espacios de Barcelona para eventos privados de cualquier tipo.</p>
        </article>
      </div>
      <a class="btn" href="mailto:grupofomo@gmail.com">Solicitar más información</a>
    </div>
  </section>

  <div class="band-dark bar-title">
    <h2 class="wrap">Nuestros proyectos</h2>
  </div>

  <section>
    <div class="wrap">
      <EventoFeature evento={graduacions} etiqueta="Eventos privados" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <EventoFeature evento={club} izquierda etiqueta="Gestión de local" />
    </div>
  </section>

  <section>
    <div class="wrap">
      {fiestas.map((f, i) => <EventoFeature evento={f} izquierda={i % 2 === 1} etiqueta="Marca propia" />)}
      <EventoFeature evento={padel} izquierda etiqueta="Evento solidario" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <span class="label">Más marcas</span>
      </div>
      <div class="marcas">
        {marcas.map((m) => (
          <div class="marca" id={m.id}>
            <div class="photo logo-panel">{m.logo ? <img src={m.logo} alt={m.nombre} loading="lazy"> : <span class="logo-texto">{m.nombre}</span>}</div>
            <div class="meta">{m.meta.map((t) => <span>{t}</span>)}</div>
            <h3>{m.nombre}</h3>
            <p>{m.texto}</p>
            {m.facebook && <a class="btn" href={m.facebook} target="_blank" rel="noopener">Facebook</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <Contacto />
</Base>
